# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Binaries
cmd/gophkeeperserver/main
cmd/gophkeeperserver/gophkeeperserver
cmd/gophkeeperclient/main
cmd/gophkeeperclient/gophkeeperclient
cmd/staticlint/main

# Dependency directories (remove the comment below to include it)
vendor/

# IDEs directories
.idea
.vscode

# Go workspace file
go.work
go.work.sum

# env file
.env

# logs
*.log

# cert an key
*.pem

# SAST plugin
.ai
